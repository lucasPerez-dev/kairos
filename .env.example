# ---- Kairos : configuration ----------------------------------------------
# Copier ce fichier en `.env` et remplir les valeurs. Le `.env` NE DOIT PAS
# être committé (voir .gitignore).

# Token du bot Telegram (via @BotFather). Laissez vide pour désactiver le bot
# et ne lancer que le dashboard.
KAIROS_TELEGRAM_BOT_TOKEN=

# ID du groupe Telegram du week-end. Pas indispensable : envoyez /id au bot
# depuis le groupe pour le connaître, puis mettez-le ici pour les alertes
# automatiques (les alertes sans chat_id ne partent nulle part).
KAIROS_TELEGRAM_CHAT_ID=

# Mode de fonctionnement :
#   collect = collecte historique discrète, aucune alerte envoyée
#   trip    = mode séjour, alertes et rappels activés
KAIROS_MODE=collect

# Fréquence de sondage de queue-times.com (secondes).
KAIROS_POLL_INTERVAL_SECONDS=300

# Seuil par défaut des alertes "ça se libère" (minutes).
KAIROS_ALERT_DEFAULT_THRESHOLD_MINUTES=15

# Anti-spam : délai minimum entre deux alertes pour une même attraction.
KAIROS_ALERT_COOLDOWN_MINUTES=30

# Dashboard web (accessible LAN + Tailscale).
KAIROS_DASHBOARD_ENABLED=true
KAIROS_DASHBOARD_HOST=0.0.0.0
KAIROS_DASHBOARD_PORT=8080

# Fuseau horaire du parc.
KAIROS_TIMEZONE=Europe/Madrid

# Forcer l'IPv4 pour Telegram et queue-times. Recommandé : évite les blocages
# quand le domaine résout en IPv6 mais que l'IPv6 ne fonctionne pas.
KAIROS_FORCE_IPV4=true

# Ne pas sonder quand le parc est fermé (selon config/hours.json). Évite de
# stocker des données inutiles ; mets false pour collecter 24h/24.
KAIROS_SKIP_WHEN_CLOSED=true

# Base de données SQLite.
KAIROS_DB_PATH=data/kairos.db

# Rétention de l'historique (jours). 0 = illimité.
KAIROS_HISTORY_RETENTION_DAYS=0
